# Copy to .env and fill in if you want to enable live trading:
#   cp .env.example .env && chmod 600 .env
# Paper mode and unit tests do not need credentials. Never commit .env or a real private key.
#
# This project does not auto-load .env. Export the variables in your shell, for example:
#   set -a && source .env && set +a

# Kalshi API credentials — needed only for live trading.
KALSHI_API_KEY_ID=your_kalshi_api_key_id_here
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...paste key here...\n-----END RSA PRIVATE KEY-----"
